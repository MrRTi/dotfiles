#!/usr/bin/env bash
# vim: set ft=sh :

set -euo pipefail

db_create() {
  local engine db_name dsn

  if [[ $# -eq 2 ]]; then
    engine="$1"
    db_name="$2"
  elif [[ $# -eq 1 ]]; then
    db_name="$1"
    engine=$(printf 'postgres\nmysql\nmongo' | fzf --prompt="Database engine: ") || return 1
  else
    echo "Usage: db-create [db-type] <db-name>" >&2
    return 1
  fi

  case "$engine" in
    postgres)
      dsn="pg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/postgres"
      if usql "$dsn" -qc "SELECT 1 FROM pg_database WHERE datname = '$db_name'" 2>/dev/null | grep -q 1; then
        echo "Error: postgres database '$db_name' already exists" >&2
        return 1
      fi
      usql "$dsn" -qc "CREATE DATABASE \"$db_name\""
      echo "Created postgres database '$db_name'"
      ;;
    mysql)
      dsn="my://root:${MYSQL_ROOT_PASSWORD}@127.0.0.1:3306/"
      if usql "$dsn" -qc "SELECT SCHEMA_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME = '$db_name'" 2>/dev/null | grep -q "$db_name"; then
        echo "Error: mysql database '$db_name' already exists" >&2
        return 1
      fi
      usql "$dsn" -qc "CREATE DATABASE \`$db_name\`"
      echo "Created mysql database '$db_name'"
      ;;
    mongo)
      dsn="mg://${MONGO_ROOT_USER}:${MONGO_ROOT_PASSWORD}@localhost:27017/?authSource=admin"
      if usql "$dsn" -qc "show databases" 2>/dev/null | grep -qw "$db_name"; then
        echo "Error: mongo database '$db_name' already exists" >&2
        return 1
      fi
      usql "$dsn/$db_name" -qc "db.createCollection('_init')"
      echo "Created mongo database '$db_name'"
      ;;
    *)
      echo "Error: unknown engine '$engine' (postgres, mysql, mongo)" >&2
      return 1
      ;;
  esac
}

db_create "$@"
