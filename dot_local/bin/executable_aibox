#!/usr/bin/env bash
# vim: set ft=sh :
# aibox — run an AI agent for the current git worktree in a locked-down
# OrbStack sandbox. Policy lives in the chezmoi source (aibox/), never in
# the project repo. See aibox/lib.sh.

set -euo pipefail

AIBOX_HOME="${AIBOX_HOME:-$(chezmoi source-path)/aibox}"
export AIBOX_HOME
# shellcheck source=SCRIPTDIR/../../aibox/lib.sh
source "$AIBOX_HOME/lib.sh"

usage() {
  cat >&2 <<'USAGE'
usage: aibox info    show what the sandbox would get for this worktree
USAGE
  exit 2
}

die() {
  printf 'aibox: %s\n' "$*" >&2
  exit 1
}

# Sets WORKTREE, SLUG, CONFIG, TIER for the current directory.
resolve_project() {
  WORKTREE=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
  WORKTREE=$(cd "$WORKTREE" && pwd -P)
  aibox_refuse_policy_repo "$WORKTREE" || exit 1
  SLUG=$(aibox_project_slug "$WORKTREE") || die "cannot resolve project for $WORKTREE"
  CONFIG="$AIBOX_HOME/projects/$SLUG/config"
  TIER=$(aibox_tier "$WORKTREE" "$CONFIG")
}

cmd_info() {
  resolve_project
  printf 'worktree: %s\n' "$WORKTREE"
  printf 'project:  %s\n' "$SLUG"
  printf 'tier:     %s\n' "$TIER"
  if [[ -f $CONFIG ]]; then
    printf 'config:   %s\n' "$CONFIG"
  else
    printf 'config:   (none, defaults)\n'
  fi
  printf 'allowlist:\n'
  aibox_merge_allow "$TIER" "$SLUG" /dev/null | sed 's/^/  /'
}

case "${1:-}" in
  info) cmd_info ;;
  *) usage ;;
esac
