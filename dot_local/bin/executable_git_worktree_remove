#!/usr/bin/env bash
if [[ -n "$1" ]]; then
	root="$1"
else
	root=$(git_worktree_base) || exit 1
fi
cd "$root/main" || exit 1

git worktree list |
	awk '{print $1}' |
	fzf --multi --header "Project: $root" |
	while read -r line; do
		git worktree remove --force "$line"
		echo "Worktree '${line}' removed"
	done
