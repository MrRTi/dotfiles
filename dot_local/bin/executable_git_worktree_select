#!/usr/bin/env bash
root=$(git_worktree_base) || exit 1
cd "$root/main" || exit 1

git worktree list |
	awk '{printf "\x1b[34m %s\x1b[0m\t\x1b[33m%s\x1b[0m\n", ($3 == "" ? "(root)" : $3), $1}' |
	sed "s:$root:󰾛 :" |
	sed "/ (root)*/d" |
	column -t |
	fzf --ansi --query "${1:-}" |
	sed "s:.*󰾛 *:$root:"
