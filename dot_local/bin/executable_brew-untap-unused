#!/usr/bin/env bash
set -euo pipefail

dry_run=false
[[ "${1:-}" == "--dry-run" ]] && dry_run=true

echo "Collecting installed packages..."

mapfile -t installed_formulae < <(brew list --formula 2>/dev/null)
mapfile -t installed_casks < <(brew list --cask 2>/dev/null)

echo ""
while IFS= read -r tap; do
    tap_json=$(brew tap-info --json "$tap" 2>/dev/null)

    mapfile -t tap_formulae < <(echo "$tap_json" | jq -r '.[].formula_names[] | split("/")[-1]')
    mapfile -t tap_casks < <(echo "$tap_json" | jq -r '.[].cask_tokens[] | split("/")[-1]')

    used=false
    for f in "${tap_formulae[@]+"${tap_formulae[@]}"}"; do
        printf '%s\n' "${installed_formulae[@]+"${installed_formulae[@]}"}" | grep -qx "$f" && used=true && break
    done
    if ! $used; then
        for c in "${tap_casks[@]+"${tap_casks[@]}"}"; do
            printf '%s\n' "${installed_casks[@]+"${installed_casks[@]}"}" | grep -qx "$c" && used=true && break
        done
    fi

    if $used; then
        echo "  keep   $tap"
    else
        echo "  untap  $tap"
        if ! $dry_run; then
            brew untap "$tap"
        fi
    fi
done < <(brew tap)

$dry_run && echo "" && echo "(dry run — nothing removed)"
