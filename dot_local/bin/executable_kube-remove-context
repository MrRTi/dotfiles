#!/usr/bin/env bash
set -euo pipefail

_KC_CTX=$(kubectl config get-contexts -o name | fzf --prompt="Select context to remove: ") || exit 0

_KC_CLUSTER=$(kubectl config view -o jsonpath="{.contexts[?(@.name=='${_KC_CTX}')].context.cluster}")
_KC_USER=$(kubectl config view -o jsonpath="{.contexts[?(@.name=='${_KC_CTX}')].context.user}")

echo "Removing:"
echo "  Context: ${_KC_CTX}"
echo "  Cluster: ${_KC_CLUSTER}"
echo "  User:    ${_KC_USER}"
echo

read -rp "Proceed? [y/N] " confirm
[[ "${confirm}" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }

kubectl config delete-context "${_KC_CTX}"
[[ -n "${_KC_CLUSTER}" ]] && kubectl config delete-cluster "${_KC_CLUSTER}"
[[ -n "${_KC_USER}" ]] && kubectl config delete-user "${_KC_USER}"

echo "Done."
