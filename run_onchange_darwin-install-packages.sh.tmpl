#!/usr/bin/env bash

{{ if eq .chezmoi.os "darwin" -}}

brew bundle --file=/dev/stdin <<EOF
{{ range .packages.darwin.taps -}}
tap {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.brews_with_options -}}
brew {{ .name | quote }}, {{ .options }}
{{ end -}}
{{ range .packages.darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF

# Install Mac App Store apps individually so failures don't block the rest
{{ range .packages.darwin.mas -}}
mas install {{ .id }} || echo "Failed to install {{ .name }} ({{ .id }}) — install manually from App Store"
{{ end -}}
{{ end -}}
