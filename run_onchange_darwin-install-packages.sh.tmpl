#!/usr/bin/env bash

{{ if eq .chezmoi.os "darwin" -}}

{{ $brewfile := joinPath .chezmoi.sourceDir "Brewfile" -}}
{{ if stat $brewfile -}}
# Brewfile checksum: {{ include "Brewfile" | sha256sum }}

brew bundle --file="{{ .chezmoi.homeDir }}/Brewfile"

# Register fish as a valid login shell
FISH_PATH="$(brew --prefix)/bin/fish"
if ! grep -qF "$FISH_PATH" /etc/shells; then
	echo "$FISH_PATH" | sudo tee -a /etc/shells
fi
{{ else -}}
echo "Brewfile not found in chezmoi source — run 'just brew-dump && just brew-sync' first"
{{ end -}}

{{ end -}}
