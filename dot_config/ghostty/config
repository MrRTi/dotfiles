quit-after-last-window-closed = true
macos-option-as-alt = true

font-family = "JetBrains Mono"
font-size = 16
font-thicken = true
font-feature = -calt, -liga, -dlig

maximize = true
window-padding-x = 10
window-padding-y = 5

theme = dark:Kanagawa Dragon,light:Kanagawa Lotus
cursor-color = #e46876
background-opacity = 0.93
background-blur = 10

