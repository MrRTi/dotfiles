# Prompt (PS1)
# Colors
C_RESET='\[\e[0m\]'
C_PATH='\[\e[34m\]' # blue
C_GIT='\[\e[33m\]'  # yellow
C_USER='\[\e[32m\]' # green

SSH_INFO=""
[ -n "$SSH_TTY" ] && SSH_INFO="${C_USER}\u@\h${C_RESET}:"

PS1="${SSH_INFO}${C_PATH}\$(__short_path)${C_RESET}${C_GIT}\$(__git_ps1 \" (%s)\")${C_RESET} \n\$ "
