# shellcheck shell=bash
# vim: set ft=sh :

# Non-interactive guard — prevents SCP and non-interactive shells from running interactive setup
[[ $- != *i* ]] && return

# Shell options and history
set -o emacs

shopt -s histappend
shopt -s histverify
shopt -s cdspell
shopt -s direxpand
shopt -s checkwinsize

HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
HISTTIMEFORMAT='%F %T '

PROMPT_COMMAND="history -a; $PROMPT_COMMAND"

# Environment variables and PATH
export PATH="/opt/homebrew/bin:$HOME/.local/bin:$HOME/.orbstack/bin:$HOME/.cargo/bin:$PATH"
export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"
export LDFLAGS="-L/opt/homebrew/opt/libpq/lib"
export CPPFLAGS="-I/opt/homebrew/opt/libpq/include"
export EDITOR=nvim
export VISUAL=nvim

# Tool integrations
if command -v mise >/dev/null 2>&1; then
	eval "$(mise activate bash)"
fi

if command -v direnv >/dev/null 2>&1; then
	eval "$(direnv hook bash)"
fi

# Bash completion
for f in /opt/homebrew/etc/profile.d/bash_completion.sh \
	/usr/local/etc/profile.d/bash_completion.sh \
	/usr/share/bash-completion/bash_completion \
	/etc/bash_completion; do
	# shellcheck source=/dev/null
	[ -f "$f" ] && source "$f" && break
done

# Git prompt
for f in /opt/homebrew/etc/bash_completion.d/git-prompt.sh \
	/usr/local/etc/bash_completion.d/git-prompt.sh \
	/usr/share/git-core/contrib/completion/git-prompt.sh; do
	# shellcheck source=/dev/null
	[ -f "$f" ] && source "$f" && break
done

# Fallback no-op if git-prompt.sh was not found
if ! type -t __git_ps1 >/dev/null 2>&1; then
	__git_ps1() { :; }
fi

# Git status options (exported for __git_ps1)
export GIT_PS1_SHOWDIRTYSTATE=1
export GIT_PS1_SHOWUNTRACKEDFILES=1
export GIT_PS1_SHOWUPSTREAM="auto"

# Functions
# Most logic lives in ~/.local/bin/ scripts (shell-agnostic).
# Only wrappers that need to cd or source live here.

git_clone_to_worktree() {
	local path
	path=$(command git_clone_to_worktree "$@") || return 1
	[ -z "$path" ] && return 1
	cd "$path" || return 1
}

git_worktree_switch() {
	local path
	path=$(git_worktree_select "$1") || return 1
	[ -z "$path" ] && return 1
	cd "$path" || return 1
}

git_worktree_add_query() {
	local path
	path=$(command git_worktree_add_query "$1") || return 1
	[ -z "$path" ] && return 1
	cd "$path" || return 1
}

chezmoi_cd() {
	cd "$(chezmoi source-path)" || return 1
}

gpf() {
	local branch
	branch=$(git current-branch) || return 1
	[ -z "$branch" ] && { echo "gpf: no current branch (detached HEAD?)" >&2; return 1; }
	git push --force-with-lease origin "$branch"
}

gres() {
	local branch
	branch=$(git current-branch) || return 1
	[ -z "$branch" ] && { echo "gres: no current branch (detached HEAD?)" >&2; return 1; }
	git reset --hard "origin/$branch"
}

venv_init() {
	local root
	root=$(git rev-parse --show-toplevel 2>/dev/null) || {
		echo "error: not a git repo" >&2
		return 1
	}

	if [ ! -d "$root/.venv" ]; then
		echo "→ creating .venv"
		python3 -m venv "$root/.venv"
	fi

	source "$root/.venv/bin/activate"
	echo "✓ activated $root/.venv"

	if [ -f "$root/requirements.txt" ]; then
		echo "→ installing requirements.txt"
		pip install -q -r "$root/requirements.txt"
		echo "✓ done"
	fi
}

