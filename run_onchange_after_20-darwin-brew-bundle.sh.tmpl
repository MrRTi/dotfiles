{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# set -e: a failed install must not go on to `brew bundle cleanup`.
set -euo pipefail
# Installs Homebrew on a fresh Mac. mise is standalone and installs before this
# (run_onchange_after_10), so this is the only script that needs brew.
if [[ ! -x /opt/homebrew/bin/brew ]]; then
	/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
PATH="/opt/homebrew/bin:$PATH"

{{ $brewfile := joinPath .chezmoi.sourceDir "Brewfile" -}}
{{ if stat $brewfile -}}
# Brewfile checksum: {{ include "Brewfile" | sha256sum }}

# Install missing entries only; upgrades are explicit: `just brew-upgrade`
brew bundle install --no-upgrade --file="{{ .chezmoi.homeDir }}/Brewfile"

# NOTE: the Brewfile is authoritative. Anything installed but not listed is
# uninstalled (taps, formulae, casks; not Mac App Store apps), so removing a
# line and applying removes the package. `just brew-update` before editing the
# Brewfile keeps ad-hoc installs from being dropped. Runs after the mise install
# script, so tools that moved to mise exist before brew removes its copies.
brew bundle cleanup --force --file="{{ .chezmoi.homeDir }}/Brewfile"

# Register fish as a valid login shell
FISH_PATH="$(brew --prefix)/bin/fish"
if ! grep -qF "$FISH_PATH" /etc/shells; then
	echo "$FISH_PATH" | sudo tee -a /etc/shells
fi
{{ else -}}
echo "Brewfile not found in chezmoi source — run 'just brew-dump && just brew-sync' first"
{{ end -}}
# vim: set ft=sh :
{{ end -}}
